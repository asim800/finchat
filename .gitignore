# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/frontend/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development
.env.production
.env.test
# Allow .env.example to be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python (basic - services have their own .gitignore)
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Working/planning logs and scratch notes (kept out of git, now under docs/)
docs/todo.md
docs/tasks.md
docs/dev-notes.txt
pythonscripts/*

# Note: the FastAPI service lives in a separate repository
# Exclude FastAPI service directory (deployed separately)
services/fastapi-portfolio-service/

# Test / screenshot artifacts (e.g. Playwright MCP output)
.playwright-mcp/
/*.png

# Dev-only scratch pages/examples (kept locally, not shipped to the repo)
frontend/src/app/test-analytics/
frontend/src/app/test-dashboard/
frontend/src/examples/

